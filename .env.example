# ===== LLM（OpenAI 兼容协议；DeepSeek/智谱/通义/Moonshot/new-api 等通用）=====
# 解梦 / 情绪回应都走这套配置。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash
# 换 provider 示例：
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# 智谱GLM官方: LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-plus

# ===== 数据库（SQLite，用户/解梦/日记 持久化）=====
DB_PATH=./data/mengyu.db

# ===== 会话签名密钥（itsdangerous）=====
# 生产环境务必改为一个随机长字符串，例如：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me

# ===== 路径与运行 =====
HOST=0.0.0.0
PORT=8000
# 运行环境：dev / development / test / local 视为开发模式（cookie 不标 Secure，
# 占位符 SECRET_KEY 仅告警）；其余取值（如 prod）视为生产——此时 SECRET_KEY
# 仍为占位符会直接拒绝启动，且会话 cookie 标记 Secure（仅 HTTPS 传输）。
# 生产部署务必设为 prod 并更换随机 SECRET_KEY。
APP_ENV=dev
# 应用日志级别（app.* logger）：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
# app.* 日志轮转文件（UTF-8，10MB×5 份）；留空 = 仅控制台输出
# 生产建议开启：LOG_FILE=data/logs/app.log
LOG_FILE=
# CSP 模式：enforce=强制拦截(默认) / report-only=仅上报不拦截（上线前可先试跑）
CSP_MODE=enforce

# ===== 告警（可选）=====
# 企业微信/钉钉机器人 webhook：LLM 连续失败达阈值时推送告警；留空 = 关闭
ALERT_WEBHOOK_URL=
# 连续失败多少次触发告警（两次告警之间至少间隔 10 分钟）
ALERT_LLM_FAIL_THRESHOLD=3
